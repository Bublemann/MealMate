# MealMate (plan § 11.2 step 8). Installed by setup.sh from the running image.
[Unit]
Description=MealMate manual backup (admin page request)
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
Environment=HOME=/root
ExecStart=/srv/mealmate/bin/backup.sh --label manual
TimeoutStartSec=30min
