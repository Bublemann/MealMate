# MealMate (plan § 11.2 step 8). Installed by setup.sh from the running image.
[Unit]
Description=MealMate Open Food Facts refresh
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
Environment=HOME=/root
ExecStart=/srv/mealmate/bin/mm-compose exec -T app mealmate jobs off-refresh
TimeoutStartSec=30min
# Skipped (not failed) while the running version has no such job (before milestone M7).
ExecCondition=/bin/sh -c '/srv/mealmate/bin/mm-compose exec -T app mealmate jobs off-refresh --help >/dev/null 2>&1'
