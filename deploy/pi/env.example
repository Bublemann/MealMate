# /srv/mealmate/.env on the Pi: written by setup.sh, mode 0600, owned by root (SEC-02).
# Only MEALMATE_* values reach the container; IMAGE_TAG and the HC_* ping URLs stay on the host.

# Random key from `openssl rand`; rotating it (setup.sh --rotate-secret) logs everyone out.
MEALMATE_SECRET_KEY=<generated by setup.sh>
# The Pi's Tailscale HTTPS address, used to build invite and reset links.
MEALMATE_PUBLIC_URL=https://mealmate.example.ts.net

# Version line the Pi follows: X.Y-pre for pre-releases, X.Y for releases (plan § 11.5).
# Switching it is this one-line edit followed by bin/update.sh. The verified digest that actually
# runs is pinned separately in state/override.env (IMAGE_REF), written by setup.sh and update.sh.
IMAGE_TAG=2.0-pre

# healthchecks.io ping URLs (plan § 11.4, docs/operations.md § 5); leave empty to disable a check.
# The Mac's mac-pull URL lives in the Mac's ~/.mealmate-backup/config instead.
HC_HEARTBEAT_URL=
HC_BACKUP_URL=
HC_UPDATE_URL=
HC_DISK_URL=
